# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/hackhub
# NOTE: Redis is intentionally absent. Rate limits and the SSE event bus are
# in-process, so the API runs as a single instance (see README).

# Auth (session + CSRF + social login)
JWT_SECRET=change_me
ACCESS_TOKEN_SECRET=change_me_too
CSRF_SECRET=change_me_again
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Transactional email (Resend). For local dev without a working key, set
# DEV_AUTO_VERIFY=true to skip email verification (development only).
RESEND_API_KEY=
DEV_AUTO_VERIFY=false
EMAIL_FROM=HackHub <no-reply@example.com>

# Persistent avatar storage (Cloudinary).
# Avatar upload/removal returns HTTP 503 until all three values are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability
LOG_LEVEL=info
SENTRY_DSN=
METRICS_TOKEN=
CORS_ORIGIN=http://localhost:5173

# Hackathon scraper (see docs/SCRAPERS.md)
# Disabled by default. Enable to run the daily in-process job on an always-on
# host; on sleeping hosts use .github/workflows/scrape-hackathons.yml instead.
SCRAPER_ENABLED=false
SCRAPER_CRON=30 2 * * *
SCRAPER_TIMEZONE=Asia/Kolkata
SCRAPER_SOURCES=
SCRAPER_MAX_PAGES=10
SCRAPER_TIMEOUT_MS=20000
# Optional paid discovery source (Google/LinkedIn-adjacent results).
SERPAPI_KEY=
SCRAPER_SEARCH_QUERIES=

# Team collaboration
# Maximum join requests one user may send in a rolling 24 hours.
MAX_JOIN_REQUESTS_PER_DAY=10
