# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/hackhub
REDIS_URL=redis://localhost:6379

# Auth (session + CSRF + social login)
JWT_SECRET=change_me
ACCESS_TOKEN_SECRET=change_me_too
CSRF_SECRET=change_me_again
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Transactional email (Resend). Leave blank to skip sending in local dev.
RESEND_API_KEY=
EMAIL_FROM=HackHub <no-reply@example.com>

# Observability
LOG_LEVEL=info
SENTRY_DSN=
METRICS_TOKEN=
CORS_ORIGIN=http://localhost:5173

# Team collaboration
# Maximum join requests one user may send in a rolling 24 hours.
MAX_JOIN_REQUESTS_PER_DAY=10
