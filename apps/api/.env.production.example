# Production values. Copy to the Render dashboard + Vercel project settings.
# Never commit real secrets. See docs/production-operations.md and
# docs/staging.md sections 3 and 5.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<production-user>:<password>@<production-cluster>/hackhub
# NOTE: Redis is intentionally absent (single-instance deployment).

# Auth (session + CSRF + social login). JWT_SECRET, ACCESS_TOKEN_SECRET and
# CSRF_SECRET are REQUIRED: the server refuses to boot without them. Use
# separate, high-entropy values for production; never reuse staging secrets.
JWT_SECRET=<generate-a-long-random-production-value>
ACCESS_TOKEN_SECRET=<generate-a-separate-long-random-production-value>
CSRF_SECRET=<generate-a-separate-long-random-production-value>
FRONTEND_URL=https://<production-frontend-domain>
API_BASE_URL=https://<production-api-domain>
GOOGLE_CLIENT_ID=<production-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<production-google-oauth-client-secret>
GOOGLE_CALLBACK_URL=https://<production-api-domain>/api/auth/google/callback
GITHUB_CLIENT_ID=<production-github-oauth-client-id>
GITHUB_CLIENT_SECRET=<production-github-oauth-client-secret>
GITHUB_CALLBACK_URL=https://<production-api-domain>/api/auth/github/callback

# Transactional email (Resend)
RESEND_API_KEY=<production-resend-api-key>
EMAIL_FROM=HackHub <no-reply@<production-frontend-domain>>

# Persistent avatar storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=<production-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<production-cloudinary-api-key>
CLOUDINARY_API_SECRET=<production-cloudinary-api-secret>

# Observability
LOG_LEVEL=info
SENTRY_DSN=<production-backend-sentry-dsn>
METRICS_TOKEN=<random-production-scrape-token>
CORS_ORIGIN=https://<production-frontend-domain>

# Team collaboration
MAX_JOIN_REQUESTS_PER_DAY=10
