# Staging values. Copy to the Render dashboard + Vercel project settings.
# Never commit real secrets. See docs/staging.md sections 3 and 5.
NODE_ENV=staging
PORT=5000
MONGODB_URI=mongodb+srv://<staging-user>:<password>@<staging-cluster>/hackhub-staging
REDIS_URL=redis://<staging-redis-host>:6379

# Auth (session + CSRF + social login). JWT_SECRET, ACCESS_TOKEN_SECRET and
# CSRF_SECRET are REQUIRED: the server refuses to boot without them.
JWT_SECRET=<generate-a-long-random-value-for-staging>
ACCESS_TOKEN_SECRET=<generate-a-separate-long-random-value>
CSRF_SECRET=<generate-a-separate-long-random-value>
FRONTEND_URL=https://<staging-frontend-domain>
API_BASE_URL=https://<staging-api-domain>
GOOGLE_CLIENT_ID=<staging-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<staging-google-oauth-client-secret>
GOOGLE_CALLBACK_URL=https://<staging-api-domain>/api/auth/google/callback
GITHUB_CLIENT_ID=<staging-github-oauth-client-id>
GITHUB_CLIENT_SECRET=<staging-github-oauth-client-secret>
GITHUB_CALLBACK_URL=https://<staging-api-domain>/api/auth/github/callback

# Transactional email (Resend)
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=HackHub <no-reply@example.com>

# Observability
LOG_LEVEL=info
SENTRY_DSN=<backend-sentry-dsn>
METRICS_TOKEN=<random-scrape-token>
CORS_ORIGIN=https://<staging-frontend-domain>

# Team collaboration
MAX_JOIN_REQUESTS_PER_DAY=10
