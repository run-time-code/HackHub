# Web app environment — copy to apps/web/.env and adjust. Never commit real values.
# Required: backend API base URL.
VITE_API_BASE_URL=http://localhost:5000/api
# Optional: run the whole app against in-browser MSW fixtures.
# Prefer `npm run dev:demo`, which sets this without an environment file.
VITE_USE_MOCKS=false
# Optional: Sentry browser DSN enables frontend error reporting.
VITE_SENTRY_DSN=
