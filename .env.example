# Copy this file to .env and fill in values supplied by your team.
VITE_HACKATHON_API_BASE_URL=http://localhost:3000
VITE_BOOKMARK_API_BASE_URL=http://localhost:3001
# Only use a public/client-safe key here if your backend team explicitly says it is safe.
# Never put a private/server API key in a VITE_ variable.
VITE_PUBLIC_API_KEY=
