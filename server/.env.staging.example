# Staging values. Copy to Render dashboard + Vercel project settings.
# Never commit real secrets. See docs/staging.md section 2 and 5.
NODE_ENV=staging
PORT=5000
MONGODB_URI=mongodb+srv://<staging-user>:<password>@<staging-cluster>/hackhub-staging
REDIS_URL=redis://localhost:6379
JWT_SECRET=<generate-a-long-random-value-for-staging>
LOG_LEVEL=info
CORS_ORIGIN=https://<staging-frontend-domain>
